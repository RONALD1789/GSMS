  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user profile and portal session settings."
    },
    "/schools/{schoolId}": {
      "schema": { "$ref": "#/entities/School" },
      "description": "Multi-tenant school root documents."
    },
    "/schools/{schoolId}/branches/{branchId}": {
      "schema": { "$ref": "#/entities/Branch" },
      "description": "School campus branches."
    },
    "/schools/{schoolId}/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Tenant-isolated student records."
    },
    "/schools/{schoolId}/staff/{staffId}": {
      "schema": { "$ref": "#/entities/StaffMember" },
      "description": "Tenant-isolated staff and teacher directory."
    },
    "/schools/{schoolId}/academics/{recordId}": {
      "schema": { "$ref": "#/entities/AcademicRecord" },
      "description": "Classes, subjects, timetables, exams, assessments, and marks."
    },
    "/schools/{schoolId}/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Student and staff attendance records."
    },
    "/schools/{schoolId}/report_templates/{templateId}": {
      "schema": { "$ref": "#/entities/ReportTemplate" },
      "description": "Customizable report card templates per school."
    },
    "/schools/{schoolId}/report_cards/{reportId}": {
      "schema": { "$ref": "#/entities/ReportCard" },
      "description": "Student report cards and headteacher approval workflow."
    },
    "/schools/{schoolId}/finance/{financeId}": {
      "schema": { "$ref": "#/entities/FinanceEntry" },
      "description": "Fees, invoices, payments, expenses, and payroll."
    },
    "/schools/{schoolId}/leave_requests/{leaveId}": {
      "schema": { "$ref": "#/entities/LeaveRequest" },
      "description": "Staff leave applications and approvals."
    },
    "/schools/{schoolId}/communications/{commId}": {
      "schema": { "$ref": "#/entities/CommunicationItem" },
      "description": "Announcements and multi-channel messages."
    },
    "/schools/{schoolId}/operations/{opId}": {
      "schema": { "$ref": "#/entities/OperationRecord" },
      "description": "Library, transport, welfare, discipline, inventory, hostel, admissions, and events."
    },
    "/schools/{schoolId}/alerts/{alertId}": {
      "schema": { "$ref": "#/entities/EarlyWarningAlert" },
      "description": "AI early-warning alerts and follow-up actions."
    },
    "/schools/{schoolId}/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable security and AI audit trail."
    }
  }
}
