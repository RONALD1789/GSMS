                           'schoolId', 'branchId', 'ownerId', 'channel', 'audience',
                           'title', 'body', 'senderName', 'senderRole', 'aiDrafted', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidTimestamp(incoming().createdAt) && isValidTimestamp(incoming().updatedAt) &&
