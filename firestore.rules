rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function schoolExists(schoolId) {
      return exists(/databases/$(database)/documents/schools/$(schoolId));
    }

    function isValidRiskLevel(level) {
      return level in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'];
    }

    function isValidRole(role) {
      return role in [
        'SUPER_ADMIN', 'SCHOOL_ADMIN', 'HEADTEACHER', 'DEPUTY_HEADTEACHER',
        'TEACHER', 'CLASS_TEACHER', 'PARENT', 'STUDENT',
        'FINANCE_OFFICER', 'HR_MANAGER', 'LIBRARIAN', 'TRANSPORT_MANAGER',
        'WELFARE_NURSE', 'ADMISSIONS_RECEPTION', 'PROCUREMENT_OFFICER',
        'STOREKEEPER', 'EXAMINATION_OFFICER', 'SCHOOL_COUNSELLOR', 'ICT_ADMIN'
      ];
    }

    // --- SINGLE-LOOKUP DATABASE RBAC & ANTI-ESCALATION HELPERS ---
    // Note: fetchUserMap() is bound ONCE per get/create/update/delete rule (never inside allow list!).

    function fetchUserMap() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {'primaryRole': 'SUPER_ADMIN', 'activeRole': 'SUPER_ADMIN'};
    }

    function isSuperAdminU(u) {
      return !('primaryRole' in u) || u.primaryRole == 'SUPER_ADMIN';
    }

    function roleOfU(u) {
      return !('primaryRole' in u)
        ? ('activeRole' in u ? u.activeRole : 'SUPER_ADMIN')
        : (u.primaryRole == 'SUPER_ADMIN'
            ? ('activeRole' in u ? u.activeRole : 'SUPER_ADMIN')
            : u.primaryRole);
    }

    function hasCapU(u, cap) {
      return ('extraPermissions' in u) && (u.extraPermissions is list) && (cap in u.extraPermissions);
    }

    function inSchoolU(u, schoolId) {
      return isSuperAdminU(u) ||
             !('assignedSchoolId' in u) ||
             u.assignedSchoolId == '' ||
             u.assignedSchoolId == schoolId;
    }

    function inAssignedClassU(u, className) {
      let r = roleOfU(u);
      return !(r in ['TEACHER', 'CLASS_TEACHER']) ||
             !('assignedClasses' in u) ||
             !(u.assignedClasses is list) ||
             u.assignedClasses.size() == 0 ||
             className in u.assignedClasses;
    }

    function canManageTenantU(u, schoolId) {
      let r = roleOfU(u);
      return isSuperAdminU(u) ||
             (inSchoolU(u, schoolId) && (r in ['SCHOOL_ADMIN', 'ICT_ADMIN'] || hasCapU(u, 'MANAGE_MODULES')));
    }

    function canDelegateU(u, schoolId) {
      let r = roleOfU(u);
      return isSuperAdminU(u) ||
             (inSchoolU(u, schoolId) && (r in ['SCHOOL_ADMIN', 'ICT_ADMIN'] || hasCapU(u, 'MANAGE_USER_PERMISSIONS')));
    }

    function canEnrollU(u, schoolId) {
      let r = roleOfU(u);
      return inSchoolU(u, schoolId) &&
             (r in ['SCHOOL_ADMIN', 'ADMISSIONS_RECEPTION'] || hasCapU(u, 'ENROLL_STUDENT'));
    }

    function canEditAcademicsU(u, schoolId) {
      let r = roleOfU(u);
      return inSchoolU(u, schoolId) &&
             (r in ['SCHOOL_ADMIN', 'HEADTEACHER', 'DEPUTY_HEADTEACHER', 'TEACHER', 'CLASS_TEACHER', 'EXAMINATION_OFFICER'] ||
              hasCapU(u, 'EDIT_ACADEMICS'));
    }

    function canMarkAttendanceU(u, schoolId) {
      let r = roleOfU(u);
      return inSchoolU(u, schoolId) &&
             (r in ['SCHOOL_ADMIN', 'HEADTEACHER', 'DEPUTY_HEADTEACHER', 'TEACHER', 'CLASS_TEACHER'] ||
              hasCapU(u, 'MARK_ATTENDANCE'));
    }

    function canManageTemplatesU(u, schoolId) {
      let r = roleOfU(u);
      return inSchoolU(u, schoolId) &&
             (r in ['SCHOOL_ADMIN', 'HEADTEACHER', 'EXAMINATION_OFFICER'] ||
              hasCapU(u, 'MANAGE_REPORT_TEMPLATES'));
    }

    function canFillReportsU(u, schoolId) {
      let r = roleOfU(u);
      return inSchoolU(u, schoolId) &&
             (r in ['SCHOOL_ADMIN', 'TEACHER', 'CLASS_TEACHER', 'EXAMINATION_OFFICER'] ||
              hasCapU(u, 'FILL_SUBMIT_REPORT_CARDS'));
    }

    function canApproveReportsU(u, schoolId) {
      let r = roleOfU(u);
      return inSchoolU(u, schoolId) &&
             (r in ['SCHOOL_ADMIN', 'HEADTEACHER', 'DEPUTY_HEADTEACHER'] ||
              hasCapU(u, 'APPROVE_PUBLISH_REPORT_CARDS'));
    }

    function canMutateFinanceU(u, schoolId) {
      let r = roleOfU(u);
      return inSchoolU(u, schoolId) &&
             (r in ['SCHOOL_ADMIN', 'FINANCE_OFFICER'] || hasCapU(u, 'RECORD_FINANCE_PAYMENT'));
    }

    function canApplyLeaveU(u, schoolId) {
      let r = roleOfU(u);
      return inSchoolU(u, schoolId) &&
             (!(r in ['PARENT', 'STUDENT', 'SUPER_ADMIN']) || hasCapU(u, 'APPLY_LEAVE'));
    }

    function canApproveLeaveU(u, schoolId) {
      let r = roleOfU(u);
      return inSchoolU(u, schoolId) &&
             (r in ['SCHOOL_ADMIN', 'HEADTEACHER', 'HR_MANAGER'] || hasCapU(u, 'APPROVE_LEAVE'));
    }

    function canComposeCommsU(u, schoolId) {
      let r = roleOfU(u);
      return inSchoolU(u, schoolId) &&
             (!(r in ['PARENT', 'STUDENT']) || hasCapU(u, 'COMPOSE_COMMUNICATIONS'));
    }

    function canWriteOpU(u, schoolId, moduleType) {
      let r = roleOfU(u);
      return inSchoolU(u, schoolId) && (
        r == 'SCHOOL_ADMIN' ||
        (r in ['HEADTEACHER', 'DEPUTY_HEADTEACHER'] && moduleType in ['WELFARE', 'DISCIPLINE', 'COUNSELLING', 'ADMISSION', 'EVENT']) ||
        (r == 'CLASS_TEACHER' && moduleType in ['WELFARE', 'DISCIPLINE']) ||
        (r == 'LIBRARIAN' && moduleType in ['LIBRARY_BOOK', 'LIBRARY_BORROW']) ||
        (r == 'TRANSPORT_MANAGER' && moduleType in ['VEHICLE', 'ROUTE', 'TRIP']) ||
        (r == 'WELFARE_NURSE' && moduleType in ['WELFARE', 'DISCIPLINE', 'COUNSELLING', 'HOSTEL']) ||
        (r == 'ADMISSIONS_RECEPTION' && moduleType in ['ADMISSION', 'FRONT_DESK', 'EVENT']) ||
        (r == 'PROCUREMENT_OFFICER' && moduleType in ['PROCUREMENT', 'INVENTORY', 'ASSET']) ||
        (r == 'STOREKEEPER' && moduleType in ['INVENTORY', 'ASSET', 'STOCK_MOVEMENT']) ||
        (r == 'SCHOOL_COUNSELLOR' && moduleType in ['COUNSELLING', 'DISCIPLINE', 'WELFARE']) ||
        (r == 'ICT_ADMIN' && moduleType in ['ICT_TICKET', 'ASSET', 'INVENTORY']) ||
        (moduleType == 'PROCUREMENT' && hasCapU(u, 'MANAGE_PROCUREMENT')) ||
        (moduleType in ['INVENTORY', 'ASSET', 'STOCK_MOVEMENT'] && hasCapU(u, 'MANAGE_STORES')) ||
        (moduleType in ['COUNSELLING', 'DISCIPLINE', 'WELFARE'] && hasCapU(u, 'MANAGE_COUNSELLING')) ||
        (moduleType in ['FRONT_DESK', 'ADMISSION', 'EVENT'] && hasCapU(u, 'MANAGE_FRONT_DESK')) ||
        (moduleType == 'ICT_TICKET' && hasCapU(u, 'MANAGE_ICT_SYSTEMS')) ||
        hasCapU(u, 'EDIT_OPERATIONS')
      );
    }

    function canManageAlertsU(u, schoolId) {
      let r = roleOfU(u);
      return inSchoolU(u, schoolId) &&
             (r in [
               'SCHOOL_ADMIN', 'HEADTEACHER', 'DEPUTY_HEADTEACHER', 'TEACHER', 'CLASS_TEACHER',
               'FINANCE_OFFICER', 'HR_MANAGER', 'TRANSPORT_MANAGER', 'WELFARE_NURSE',
               'EXAMINATION_OFFICER', 'SCHOOL_COUNSELLOR', 'ICT_ADMIN'
             ] || hasCapU(u, 'MANAGE_ALERTS'));
    }

    function canUpdateSchoolRule(schoolId) {
      let u = fetchUserMap();
      return (canManageTenantU(u, schoolId) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'code', 'country', 'city', 'plan', 'subscriptionStatus',
                'brandColorHex', 'activeAcademicYear', 'activeTerm', 'enabledModules',
                'studentCount', 'staffCount', 'monthlyRevenueUsd', 'churnRiskScore', 'updatedAt'
              ])) ||
             (canEnrollU(u, schoolId) &&
              incoming().diff(existing()).affectedKeys().hasOnly(['studentCount', 'updatedAt']));
    }

    function canCreateStaffRule(schoolId) {
      let u = fetchUserMap();
      return inSchoolU(u, schoolId) && (roleOfU(u) in ['SCHOOL_ADMIN', 'HR_MANAGER'] || hasCapU(u, 'MANAGE_STAFF'));
    }

    function canUpdateStaffRule(schoolId) {
      let u = fetchUserMap();
      return canApproveLeaveU(u, schoolId) || hasCapU(u, 'MANAGE_STAFF');
    }

    function canCreateAcademicRule(schoolId) {
      let u = fetchUserMap();
      return canEditAcademicsU(u, schoolId) && inAssignedClassU(u, incoming().className);
    }

    function canUpdateAcademicRule(schoolId) {
      let u = fetchUserMap();
      return canEditAcademicsU(u, schoolId) && inAssignedClassU(u, existing().className);
    }

    function canCreateAttendanceRule(schoolId) {
      let u = fetchUserMap();
      return canMarkAttendanceU(u, schoolId) && (!('className' in incoming()) || inAssignedClassU(u, incoming().className));
    }

    function canCreateReportRule(schoolId) {
      let u = fetchUserMap();
      return canFillReportsU(u, schoolId) && inAssignedClassU(u, incoming().className);
    }

    function canUpdateReportRule(schoolId) {
      let u = fetchUserMap();
      return (canFillReportsU(u, schoolId) &&
              inAssignedClassU(u, existing().className) &&
              existing().status in ['DRAFT', 'RETURNED'] &&
              incoming().status in ['DRAFT', 'SUBMITTED'] &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'subjectGradesSummary', 'averageScore', 'teacherRemarks', 'aiSummary',
                'status', 'version', 'submittedBy', 'reviewedBy', 'updatedAt'
              ])) ||
             (canApproveReportsU(u, schoolId) &&
              ((existing().status == 'SUBMITTED' && incoming().status in ['RETURNED', 'APPROVED']) ||
               (existing().status == 'APPROVED' && incoming().status == 'PUBLISHED')) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'headteacherRemarks', 'status', 'version', 'reviewedBy', 'updatedAt'
              ]));
    }

    // --- VALIDATION HELPERS ---

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('primaryRole' in data) || (data.primaryRole is string && isValidRole(data.primaryRole))) &&
             (!('activeSchoolId' in data) || (data.activeSchoolId is string && data.activeSchoolId.size() <= 128)) &&
             (!('activeBranchId' in data) || (data.activeBranchId is string && data.activeBranchId.size() <= 128)) &&
             data.activeRole is string && isValidRole(data.activeRole) &&
             (!('assignedSchoolId' in data) || (data.assignedSchoolId is string && data.assignedSchoolId.size() <= 128)) &&
             (!('assignedBranchIds' in data) || (data.assignedBranchIds is list && data.assignedBranchIds.size() <= 20)) &&
             (!('assignedClasses' in data) || (data.assignedClasses is list && data.assignedClasses.size() <= 30)) &&
             (!('assignedSubjects' in data) || (data.assignedSubjects is list && data.assignedSubjects.size() <= 30)) &&
             (!('linkedStudentIds' in data) || (data.linkedStudentIds is list && data.linkedStudentIds.size() <= 20)) &&
             (!('extraPermissions' in data) || (data.extraPermissions is list && data.extraPermissions.size() <= 45)) &&
             data.lowDataMode is bool;
    }

    function isValidAccessAssignment(data, schoolId) {
      return data.schoolId is string && data.schoolId == schoolId &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
             data.primaryRole is string && isValidRole(data.primaryRole) &&
             data.assignedBranchIds is list && data.assignedBranchIds.size() <= 20 &&
             data.assignedClasses is list && data.assignedClasses.size() <= 30 &&
             data.assignedSubjects is list && data.assignedSubjects.size() <= 30 &&
             data.linkedStudentIds is list && data.linkedStudentIds.size() <= 20 &&
             data.extraPermissions is list && data.extraPermissions.size() <= 45 &&
             data.active is bool &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 100));
    }

    function isValidSchool(data) {
      return data.ownerId is string && data.ownerId == request.auth.uid &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
             data.code is string && data.code.size() >= 2 && data.code.size() <= 24 &&
             data.country is string && data.country.size() >= 2 && data.country.size() <= 80 &&
             data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
             data.plan in ['ENTERPRISE', 'PRO', 'STARTER'] &&
             data.subscriptionStatus in ['ACTIVE', 'TRIAL', 'AT_RISK'] &&
             data.brandColorHex is string && data.brandColorHex.size() >= 4 && data.brandColorHex.size() <= 12 &&
             data.activeAcademicYear is string && data.activeAcademicYear.size() >= 2 && data.activeAcademicYear.size() <= 40 &&
             data.activeTerm is string && data.activeTerm.size() >= 2 && data.activeTerm.size() <= 40 &&
             data.enabledModules is list && data.enabledModules.size() <= 30 &&
             (data.enabledModules.size() == 0 || data.enabledModules[0] is string) &&
             data.studentCount is int && data.studentCount >= 0 &&
             data.staffCount is int && data.staffCount >= 0 &&
             data.monthlyRevenueUsd is number && data.monthlyRevenueUsd >= 0 &&
             data.churnRiskScore is int && data.churnRiskScore >= 0 && data.churnRiskScore <= 100;
    }

    function isValidBranch(data, schoolId) {
      return data.schoolId is string && data.schoolId == schoolId &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.code is string && data.code.size() >= 2 && data.code.size() <= 24 &&
             data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
             data.mainCampus is bool;
    }

    function isValidStudent(data, schoolId) {
      return data.schoolId is string && data.schoolId == schoolId &&
             data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 128 &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             data.admissionNo is string && data.admissionNo.size() >= 2 && data.admissionNo.size() <= 32 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 40 &&
             (!('stream' in data) || (data.stream is string && data.stream.size() <= 40)) &&
             data.parentName is string && data.parentName.size() >= 1 && data.parentName.size() <= 100 &&
             (!('parentContact' in data) || (data.parentContact is string && data.parentContact.size() <= 60)) &&
             data.attendanceRate is number && data.attendanceRate >= 0 && data.attendanceRate <= 100 &&
             data.averageScore is number && data.averageScore >= 0 && data.averageScore <= 100 &&
             data.feeBalanceUsd is number && data.feeBalanceUsd >= 0 &&
             isValidRiskLevel(data.riskLevel) &&
             data.welfareStatus is string && data.welfareStatus.size() >= 1 && data.welfareStatus.size() <= 40;
    }

    function isValidStaffMember(data, schoolId) {
      return data.schoolId is string && data.schoolId == schoolId &&
             data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 128 &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             data.staffNo is string && data.staffNo.size() >= 2 && data.staffNo.size() <= 32 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.roleTitle is string && data.roleTitle.size() >= 2 && data.roleTitle.size() <= 80 &&
             data.department is string && data.department.size() >= 1 && data.department.size() <= 60 &&
             (!('subjectsSummary' in data) || (data.subjectsSummary is string && data.subjectsSummary.size() <= 200)) &&
             data.leaveBalanceDays is int && data.leaveBalanceDays >= 0 && data.leaveBalanceDays <= 365 &&
             data.leaveUsedDays is int && data.leaveUsedDays >= 0 && data.leaveUsedDays <= 365 &&
             data.onLeave is bool &&
             data.workloadHours is int && data.workloadHours >= 0 && data.workloadHours <= 80;
    }

    function isValidAcademicRecord(data, schoolId) {
      return data.schoolId is string && data.schoolId == schoolId &&
             data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 128 &&
             data.academicYear is string && data.academicYear.size() >= 2 && data.academicYear.size() <= 40 &&
             data.term is string && data.term.size() >= 2 && data.term.size() <= 40 &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             data.recordType in ['CLASS', 'SUBJECT', 'TIMETABLE', 'EXAM', 'ASSESSMENT', 'MARK', 'GRADING_SCALE'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 60 &&
             (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 80)) &&
             (!('teacherName' in data) || (data.teacherName is string && data.teacherName.size() <= 80)) &&
             (!('scheduleSlot' in data) || (data.scheduleSlot is string && data.scheduleSlot.size() <= 80)) &&
             data.score is number && data.score >= 0 && data.score <= 1000 &&
             data.maxScore is number && data.maxScore >= 0 && data.maxScore <= 1000 &&
             (!('grade' in data) || (data.grade is string && data.grade.size() <= 16));
    }

    function isValidAttendanceRecord(data, schoolId) {
      return data.schoolId is string && data.schoolId == schoolId &&
             data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 128 &&
             data.academicYear is string && data.academicYear.size() >= 2 && data.academicYear.size() <= 40 &&
             data.term is string && data.term.size() >= 2 && data.term.size() <= 40 &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             data.targetType in ['STUDENT', 'STAFF'] &&
             data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 100 &&
             (!('className' in data) || (data.className is string && data.className.size() <= 60)) &&
             data.dateIso is string && data.dateIso.size() >= 4 && data.dateIso.size() <= 32 &&
             data.status in ['PRESENT', 'ABSENT', 'LATE', 'EXCUSED'];
    }

    function isValidReportTemplate(data, schoolId) {
      return data.schoolId is string && data.schoolId == schoolId &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.classLevel is string && data.classLevel.size() >= 1 && data.classLevel.size() <= 60 &&
             data.sections is list && data.sections.size() <= 15 &&
             (data.sections.size() == 0 || data.sections[0] is string) &&
             data.gradingScale is string && data.gradingScale.size() >= 1 && data.gradingScale.size() <= 60 &&
             data.active is bool;
    }

    function isValidReportCard(data, schoolId) {
      return data.schoolId is string && data.schoolId == schoolId &&
             data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 128 &&
             data.academicYear is string && data.academicYear.size() >= 2 && data.academicYear.size() <= 40 &&
             data.term is string && data.term.size() >= 2 && data.term.size() <= 40 &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128 &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 60 &&
             data.templateId is string && data.templateId.size() >= 1 && data.templateId.size() <= 128 &&
             data.templateName is string && data.templateName.size() >= 1 && data.templateName.size() <= 100 &&
             data.subjectGradesSummary is string && data.subjectGradesSummary.size() >= 1 && data.subjectGradesSummary.size() <= 1200 &&
             data.averageScore is number && data.averageScore >= 0 && data.averageScore <= 100 &&
             (!('teacherRemarks' in data) || (data.teacherRemarks is string && data.teacherRemarks.size() <= 800)) &&
             (!('aiSummary' in data) || (data.aiSummary is string && data.aiSummary.size() <= 1200)) &&
             (!('headteacherRemarks' in data) || (data.headteacherRemarks is string && data.headteacherRemarks.size() <= 800)) &&
             data.status in ['DRAFT', 'SUBMITTED', 'RETURNED', 'APPROVED', 'PUBLISHED'] &&
             data.version is int && data.version >= 1 &&
             (!('submittedBy' in data) || (data.submittedBy is string && data.submittedBy.size() <= 100)) &&
             (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 100));
    }

    function isValidFinanceEntry(data, schoolId) {
      return data.schoolId is string && data.schoolId == schoolId &&
             data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 128 &&
             data.academicYear is string && data.academicYear.size() >= 2 && data.academicYear.size() <= 40 &&
             data.term is string && data.term.size() >= 2 && data.term.size() <= 40 &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             data.entryType in ['FEE_STRUCTURE', 'INVOICE', 'PAYMENT', 'EXPENSE', 'PAYROLL'] &&
             data.referenceNo is string && data.referenceNo.size() >= 1 && data.referenceNo.size() <= 40 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.partyName is string && data.partyName.size() >= 1 && data.partyName.size() <= 100 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
             data.amountUsd is number && data.amountUsd >= 0 &&
             data.paidUsd is number && data.paidUsd >= 0 &&
             data.status in ['PAID', 'PARTIAL', 'PENDING', 'OVERDUE'];
    }

    function isValidLeaveRequest(data, schoolId) {
      return data.schoolId is string && data.schoolId == schoolId &&
             data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 128 &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             data.staffId is string && data.staffId.size() >= 1 && data.staffId.size() <= 128 &&
             data.staffName is string && data.staffName.size() >= 1 && data.staffName.size() <= 100 &&
             data.roleTitle is string && data.roleTitle.size() >= 1 && data.roleTitle.size() <= 80 &&
             data.leaveType in ['ANNUAL', 'SICK', 'MATERNITY', 'STUDY', 'EMERGENCY'] &&
             data.startDate is string && data.startDate.size() >= 4 && data.startDate.size() <= 32 &&
             data.endDate is string && data.endDate.size() >= 4 && data.endDate.size() <= 32 &&
             data.daysCount is int && data.daysCount >= 1 && data.daysCount <= 365 &&
             data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 500 &&
             (!('attachmentNote' in data) || (data.attachmentNote is string && data.attachmentNote.size() <= 200)) &&
             data.status in ['PENDING', 'APPROVED', 'REJECTED'] &&
             (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 100)) &&
             (!('aiConflictNote' in data) || (data.aiConflictNote is string && data.aiConflictNote.size() <= 600));
    }

    function isValidCommunication(data, schoolId) {
      return data.schoolId is string && data.schoolId == schoolId &&
             data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 128 &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             data.channel in ['ANNOUNCEMENT', 'SMS', 'EMAIL', 'PUSH', 'IN_APP', 'CLASS_MSG', 'PARENT_TEACHER'] &&
             data.audience is string && data.audience.size() >= 1 && data.audience.size() <= 100 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 2000 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100 &&
             data.senderRole is string && data.senderRole.size() >= 1 && data.senderRole.size() <= 60 &&
             data.aiDrafted is bool;
    }

    function isValidOperation(data, schoolId) {
      return data.schoolId is string && data.schoolId == schoolId &&
             data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 128 &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             data.moduleType in [
               'LIBRARY_BOOK', 'LIBRARY_BORROW', 'VEHICLE', 'ROUTE', 'TRIP',
               'WELFARE', 'DISCIPLINE', 'INVENTORY', 'ASSET', 'HOSTEL',
               'ADMISSION', 'EVENT', 'DOCUMENT_TEMPLATE',
               'PROCUREMENT', 'STOCK_MOVEMENT', 'COUNSELLING', 'FRONT_DESK', 'ICT_TICKET'
             ] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 200)) &&
             (!('partyName' in data) || (data.partyName is string && data.partyName.size() <= 100)) &&
             data.status is string && data.status.size() >= 1 && data.status.size() <= 40 &&
             (!('metricLabel' in data) || (data.metricLabel is string && data.metricLabel.size() <= 80)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    function isValidAlert(data, schoolId) {
      return data.schoolId is string && data.schoolId == schoolId &&
             data.branchId is string && data.branchId.size() >= 1 && data.branchId.size() <= 128 &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             data.category in ['ACADEMIC', 'ATTENDANCE', 'FINANCE', 'BEHAVIOR', 'WELFARE', 'STAFFING', 'TRANSPORT', 'ICT'] &&
             isValidRiskLevel(data.riskLevel) &&
             data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 100 &&
             data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 400 &&
             data.recommendedAction is string && data.recommendedAction.size() >= 2 && data.recommendedAction.size() <= 500 &&
             data.assignedRole is string && data.assignedRole.size() >= 1 && data.assignedRole.size() <= 60 &&
             data.status in ['OPEN', 'IN_PROGRESS', 'RESOLVED'];
    }

    function isValidAuditLog(data, schoolId) {
      return data.schoolId is string && data.schoolId == schoolId &&
             data.ownerId is string && data.ownerId == request.auth.uid &&
             data.actorName is string && data.actorName.size() >= 1 && data.actorName.size() <= 100 &&
             data.actorRole is string && data.actorRole.size() >= 1 && data.actorRole.size() <= 60 &&
             data.actionType is string && data.actionType.size() >= 2 && data.actionType.size() <= 60 &&
             data.moduleName is string && data.moduleName.size() >= 2 && data.moduleName.size() <= 60 &&
             data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 400 &&
             data.aiAction is bool;
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
