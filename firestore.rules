                       isValidUserProfile(incoming());

      allow update: if isValidId(userId) &&
                       isOwner(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidTimestamp(incoming().updatedAt) &&
                       isValidUserProfile(incoming()) &&
                       (
                         ((!('primaryRole' in existing()) || existing().primaryRole == 'SUPER_ADMIN') &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'displayName', 'email', 'primaryRole', 'activeSchoolId', 'activeBranchId',
                             'activeRole', 'assignedSchoolId', 'assignedBranchIds', 'assignedClasses',
                             'assignedSubjects', 'linkedStudentIds', 'extraPermissions', 'lowDataMode', 'updatedAt'
                           ]) &&
                           (!('primaryRole' in existing()) || incoming().primaryRole == existing().primaryRole)
                         ) ||
                         ('primaryRole' in existing() && existing().primaryRole != 'SUPER_ADMIN' &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'displayName', 'email', 'activeBranchId', 'lowDataMode', 'updatedAt'
                           ]) &&
                           (!('assignedBranchIds' in existing()) ||
                             !('activeBranchId' in incoming()) ||
                             incoming().activeBranchId in existing().assignedBranchIds)
                         )
                       );

      allow delete: if isValidId(userId) && isOwner(userId);
    }

