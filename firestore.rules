      match /alerts/{alertId} {
        allow get: if isValidId(schoolId) && isValidId(alertId) && isOwner(existing().ownerId);
        allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(schoolId) && isValidId(alertId) && isSignedIn() &&
                         schoolExists(schoolId) &&
                         incoming().keys().hasAll([
                           'schoolId', 'branchId', 'ownerId', 'category', 'riskLevel',
                           'targetName', 'reason', 'recommendedAction', 'assignedRole',
                           'status', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'schoolId', 'branchId', 'ownerId', 'category', 'riskLevel',
                           'targetName', 'reason', 'recommendedAction', 'assignedRole',
                           'status', 'createdAt', 'updatedAt'
                         ]) &&
