                           'reason', 'status', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'schoolId', 'branchId', 'ownerId', 'staffId', 'staffName',
                           'roleTitle', 'leaveType', 'startDate', 'endDate', 'daysCount',
                           'reason', 'attachmentNote', 'status', 'reviewedBy', 'aiConflictNote',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidTimestamp(incoming().createdAt) && isValidTimestamp(incoming().updatedAt) &&
                         isValidLeaveRequest(incoming(), schoolId);
        allow update: if isValidId(schoolId) && isValidId(leaveId) && isOwner(existing().ownerId) &&
                         incoming().ownerId == existing().ownerId && incoming().schoolId == existing().schoolId &&
                         incoming().createdAt == existing().createdAt && isValidTimestamp(incoming().updatedAt) &&
                         existing().status == 'PENDING' &&
                         isValidLeaveRequest(incoming(), schoolId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'aiConflictNote', 'updatedAt']);
        allow delete: if isValidId(schoolId) && isValidId(leaveId) && isOwner(existing().ownerId);
      }

