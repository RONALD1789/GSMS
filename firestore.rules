                         ]) &&
                         isValidTimestamp(incoming().createdAt) && isValidTimestamp(incoming().updatedAt) &&
                         isValidCommunication(incoming(), schoolId);
        allow update: if isValidId(schoolId) && isValidId(commId) && isOwner(existing().ownerId) &&
                         canComposeCommsU(fetchUserMap(), schoolId) &&
                         incoming().ownerId == existing().ownerId && incoming().schoolId == existing().schoolId &&
                         incoming().createdAt == existing().createdAt && isValidTimestamp(incoming().updatedAt) &&
                         isValidCommunication(incoming(), schoolId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'audience', 'updatedAt']);
        allow delete: if isValidId(schoolId) && isValidId(commId) && isOwner(existing().ownerId) && canComposeCommsU(fetchUserMap(), schoolId);
      }

      match /operations/{opId} {
        allow get: if isValidId(schoolId) && isValidId(opId) && isOwner(existing().ownerId) && inSchoolU(fetchUserMap(), schoolId);
        allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(schoolId) && isValidId(opId) && isSignedIn() &&
                         schoolExists(schoolId) &&
                         canWriteOpU(fetchUserMap(), schoolId, incoming().moduleType) &&
                         incoming().keys().hasAll([
                           'schoolId', 'branchId', 'ownerId', 'moduleType', 'title',
                           'status', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'schoolId', 'branchId', 'ownerId', 'moduleType', 'title',
                           'subtitle', 'partyName', 'status', 'metricLabel', 'notes',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidTimestamp(incoming().createdAt) && isValidTimestamp(incoming().updatedAt) &&
                         isValidOperation(incoming(), schoolId);
        allow update: if isValidId(schoolId) && isValidId(opId) && isOwner(existing().ownerId) &&
                         canWriteOpU(fetchUserMap(), schoolId, existing().moduleType) &&
                         incoming().ownerId == existing().ownerId && incoming().schoolId == existing().schoolId &&
                         incoming().createdAt == existing().createdAt && isValidTimestamp(incoming().updatedAt) &&
                         isValidOperation(incoming(), schoolId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subtitle', 'partyName', 'status', 'metricLabel', 'notes', 'updatedAt']);
        allow delete: if isValidId(schoolId) && isValidId(opId) && isOwner(existing().ownerId) && canWriteOpU(fetchUserMap(), schoolId, existing().moduleType);
      }

      match /alerts/{alertId} {
        allow get: if isValidId(schoolId) && isValidId(alertId) && isOwner(existing().ownerId) && inSchoolU(fetchUserMap(), schoolId);
        allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(schoolId) && isValidId(alertId) && isSignedIn() &&
                         schoolExists(schoolId) &&
                         canManageAlertsU(fetchUserMap(), schoolId) &&
                         incoming().keys().hasAll([
                           'schoolId', 'branchId', 'ownerId', 'category', 'riskLevel',
                           'targetName', 'reason', 'recommendedAction', 'assignedRole',
                           'status', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'schoolId', 'branchId', 'ownerId', 'category', 'riskLevel',
                           'targetName', 'reason', 'recommendedAction', 'assignedRole',
                           'status', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidTimestamp(incoming().createdAt) && isValidTimestamp(incoming().updatedAt) &&
                         isValidAlert(incoming(), schoolId);
        allow update: if isValidId(schoolId) && isValidId(alertId) && isOwner(existing().ownerId) &&
                         canManageAlertsU(fetchUserMap(), schoolId) &&
                         incoming().ownerId == existing().ownerId && incoming().schoolId == existing().schoolId &&
                         incoming().createdAt == existing().createdAt && isValidTimestamp(incoming().updatedAt) &&
                         isValidAlert(incoming(), schoolId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'assignedRole', 'recommendedAction', 'updatedAt']);
        allow delete: if isValidId(schoolId) && isValidId(alertId) && isOwner(existing().ownerId) && canManageAlertsU(fetchUserMap(), schoolId);
      }

      match /audit_logs/{logId} {
        allow get: if isValidId(schoolId) && isValidId(logId) && isOwner(existing().ownerId) && inSchoolU(fetchUserMap(), schoolId);
        allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(schoolId) && isValidId(logId) && isSignedIn() &&
                         schoolExists(schoolId) &&
                         inSchoolU(fetchUserMap(), schoolId) &&
                         incoming().keys().hasAll([
                           'schoolId', 'ownerId', 'actorName', 'actorRole',
                           'actionType', 'moduleName', 'summary', 'aiAction', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'schoolId', 'ownerId', 'actorName', 'actorRole',
                           'actionType', 'moduleName', 'summary', 'aiAction', 'createdAt'
                         ]) &&
                         isValidTimestamp(incoming().createdAt) &&
                         isValidAuditLog(incoming(), schoolId);
        // Audit logs are immutable once created
        allow update, delete: if false;
      }
    }
  }
}
