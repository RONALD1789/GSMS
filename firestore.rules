        allow update: if isValidId(schoolId) && isValidId(templateId) && isOwner(existing().ownerId) &&
                         incoming().ownerId == existing().ownerId && incoming().schoolId == existing().schoolId &&
                         incoming().createdAt == existing().createdAt && isValidTimestamp(incoming().updatedAt) &&
                         isValidReportTemplate(incoming(), schoolId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'classLevel', 'sections', 'gradingScale', 'active', 'updatedAt']);
        allow delete: if isValidId(schoolId) && isValidId(templateId) && isOwner(existing().ownerId);
      }

      match /report_cards/{reportId} {
        allow get: if isValidId(schoolId) && isValidId(reportId) && isOwner(existing().ownerId);
        allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(schoolId) && isValidId(reportId) && isSignedIn() &&
                         schoolExists(schoolId) &&
                         incoming().keys().hasAll([
                           'schoolId', 'branchId', 'academicYear', 'term', 'ownerId',
                           'studentId', 'studentName', 'className', 'templateId', 'templateName',
                           'subjectGradesSummary', 'averageScore', 'status', 'version', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'schoolId', 'branchId', 'academicYear', 'term', 'ownerId',
                           'studentId', 'studentName', 'className', 'templateId', 'templateName',
                           'subjectGradesSummary', 'averageScore', 'teacherRemarks', 'aiSummary',
                           'headteacherRemarks', 'status', 'version', 'submittedBy', 'reviewedBy',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidTimestamp(incoming().createdAt) && isValidTimestamp(incoming().updatedAt) &&
                         isValidReportCard(incoming(), schoolId);
        allow update: if isValidId(schoolId) && isValidId(reportId) && isOwner(existing().ownerId) &&
                         incoming().ownerId == existing().ownerId && incoming().schoolId == existing().schoolId &&
                         incoming().createdAt == existing().createdAt && isValidTimestamp(incoming().updatedAt) &&
                         isValidReportCard(incoming(), schoolId) &&
                         (
                           (existing().status != 'PUBLISHED' && incoming().diff(existing()).affectedKeys().hasOnly([
                             'subjectGradesSummary', 'averageScore', 'teacherRemarks', 'aiSummary',
                             'headteacherRemarks', 'status', 'version', 'submittedBy', 'reviewedBy', 'updatedAt'
                           ])) ||
                           // Allow publishing transition or revision increment
                           (existing().status == 'APPROVED' && incoming().status == 'PUBLISHED' &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'version', 'reviewedBy', 'updatedAt']))
                         );
        allow delete: if isValidId(schoolId) && isValidId(reportId) && isOwner(existing().ownerId);
      }

      match /finance/{financeId} {
        allow get: if isValidId(schoolId) && isValidId(financeId) && isOwner(existing().ownerId);
