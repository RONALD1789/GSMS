# Gemini requests are handled by the Supabase Edge Function; store GEMINI_API_KEY as a Supabase Function secret.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Use the Supabase publishable key (sb_publishable_...). Safe for Android when RLS is correctly configured.
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Backward-compatible legacy variable. Leave blank when SUPABASE_PUBLISHABLE_KEY is set.
SUPABASE_ANON_KEY=
