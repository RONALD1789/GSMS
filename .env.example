# Firebase AI Logic relies on App Check attestation; no GEMINI_API_KEY is required.

# SUPABASE_URL: Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
# Configure this securely in the Secrets panel in AI Studio.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# SUPABASE_ANON_KEY: Your Supabase project public anon/publishable key.
# Configure this securely in the Secrets panel in AI Studio. Never put service_role keys in the app.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
