# Gemini requests are handled by the Supabase Edge Function.
# Store GEMINI_API_KEY as a Supabase Function secret, never in this file.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Use a Supabase publishable key (sb_publishable_...). RLS must protect all tenant data.
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Build-time compatibility constant only. Keep non-empty so Android BuildConfig generation
# never emits an invalid empty string assignment. Runtime prefers the publishable key above.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
